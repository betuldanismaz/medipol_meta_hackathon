# Browser'dan çağrılır (NEXT_PUBLIC_ prefix'i client bundle'a girer)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side fetch (Server Components, route handlers) bunu kullanır.
# Docker compose içinde backend servisinin adı.
API_URL_INTERNAL=http://backend:8000

# Backend hazır olmadan mock veriyle çalışmak için true yapın.
NEXT_PUBLIC_USE_MOCK=true
