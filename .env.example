# Root env örneği. docker-compose.yml env'leri default ile tanımlar;
# bu dosyayı .env'ye kopyalayıp override edebilirsiniz.

# --- OpenAI (agent müzakere; boşsa fallback deterministik agent çalışır) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# --- JWT ---
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Pricing (mock) ---
PRICE_PREMIUM_INDIVIDUAL_TRY=149
PRICE_PREMIUM_BUSINESS_TRY=499
PRICE_EXTRA_ROUNDS_TRY=29
EXTRA_ROUNDS_PER_PACK=5
MAX_NEGOTIATION_ROUNDS=10

# --- Backend ---
DATABASE_URL=postgresql://app:app@db:5432/app
CORS_ORIGINS=http://localhost:3000

# --- Eski (referans amaçlı) ---
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
